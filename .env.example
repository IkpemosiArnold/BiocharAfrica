# Contact form delivery.
#
# Set these in Vercel (Project -> Settings -> Environment Variables), NOT in a
# file in this repo. .env files are gitignored, and the password below is a real
# mailbox password: if it lands in git it is compromised and has to be changed.
#
# Until SMTP_HOST, SMTP_USER, SMTP_PASS and CONTACT_TO are all present, the
# endpoint returns 503 and the form falls back to opening a prefilled mailto, so
# nothing is silently swallowed.

# The company's own cPanel mail server. Same host as the MX record.
SMTP_HOST=mail.biocharsolutions.africa

# 465 = implicit TLS (recommended). 587 = STARTTLS, if 465 is blocked.
SMTP_PORT=465

# The mailbox to authenticate as. This needs a password set in
# cPanel -> Email Accounts -> Manage -> New Password.
SMTP_USER=info@biocharsolutions.africa
SMTP_PASS=

# Where enquiries land.
CONTACT_TO=info@biocharsolutions.africa

# The visible From address. Must be on this domain, or SPF, DKIM and DMARC all
# fail alignment and the mail is junked. The visitor's address goes in Reply-To,
# which is what makes "reply" work. Defaults to SMTP_USER if unset.
CONTACT_FROM=info@biocharsolutions.africa
